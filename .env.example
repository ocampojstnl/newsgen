# Long random value that signs sign-in sessions. Changing it signs everyone out.
SESSION_SECRET=

# Supabase > Connect > Transaction pooler. Server only.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@YOUR-REGION.pooler.supabase.com:6543/postgres

# Google AI Studio. Server only, never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite
